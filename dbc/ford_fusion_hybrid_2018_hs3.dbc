CM_ BO_ 350 "Mux 0x16/0x76/0x86 = GPS (B1:B2 lat, B5:B6 lon). Mux 0x01 = MM:SS clock. Mux 0x30 = GNSS DOP precision (B2 PDOP, B3 HDOP, B4 VDOP, scale 0.1, 00/FF invalid).";
CM_ SG_ 268 Motor_Temp "NOT motor temp. Live 64-77 / off 0. Retracted — see docs/signals.md.";
CM_ SG_ 321 High_Res_Empower_Gauge "16-bit analog cluster gauge. 10000 = 0 kW. < 10000 is regen, > 10000 is power. Was previously misidentified as Coarse HV Current (B0) + Intake MAP (B1:B2) due to byte misalignment.";
CM_ SG_ 272 Motor_Angle "B1:B2 * 360/65536 deg. B3 bit7 resolver-valid. FF FF FF asleep.";
CM_ SG_ 372 Fuel_Level "B1:B2 BE * 0.1 %. raw 0 and 1000 are invalid, not a full tank.";
CM_ SG_ 372 Fuel_Sender_Ok "B3 bits 0-1. Always 3 in every capture. Likely sender OK / data valid.";
CM_ SG_ 372 Fuel_Gauge_Update "B3 bit 7. NOT the low-fuel lamp. 1-5 s strobe at <7 km/h when filtered % commits. Real lamp unmapped — see docs/signals.md.";
CM_ SG_ 322 ICE_Running "0x64 = EV, 0x68 = ICE running.";
CM_ SG_ 261 Hybrid_Mode "0xE0 parked, 0xE8 city/EV-heavy, 0xF8 highway.";
CM_ SG_ 339 Trip_Avg_Mpg "Native 0.1 US mpg/LSB. Metric conversion: L/100 km = 235.215 / mpg.";
CM_ SG_ 274 Ctr_112_Init "B4 00 = counter block not initialised, 03 = initialised (B4:B5 >= 768). Latches 2-3 min into a drive. NOT motion. Formerly TCU_Motion.";
CM_ SG_ 435 Ambient_Light "BCM twilight level: 00 dark, 01 dawn/dusk, 05 daylight. Formerly mislabelled TCU_Presence. Reads 00 in the wake/sleep boundary frame (B1=00) - ignore it there.";
CM_ SG_ 327 Lamp_Mode "Exterior lamp mode, B5 bits 7:5. DRLs switch off on the indicating side (3/4). Parking (2) is tentative.";
CM_ SG_ 256 HV_Battery_Temp "Traction battery temperature. Was Token_SlowCount; it falls while parked, so not a counter.";
CM_ SG_ 264 Cabin_Temp "Candidate. Was Hybrid_SOC (retracted, r=0.26 vs real SOC).";
CM_ SG_ 264 Window_FL "Driver window, B1 high nibble bits 3:1: 1=closed .. 5=fully open.";
CM_ SG_ 264 Window_FR "Passenger window, B1 low nibble bits 3:1.";
CM_ SG_ 264 Window_RL "Rear-left window, B2 high nibble bits 3:1.";
CM_ SG_ 264 Window_RR "Rear-right window, B2 low nibble bits 3:1.";
CM_ SG_ 257 Gear_Selector "Rotary gear dial, B3 bits 5:4. A P-to-D turn passes R and N within ~0.4 s.";
CM_ SG_ 261 Driver_Belt "B1 bits 6:5. Not reported while Restraints_Valid (B1 bit 7) is 0 after ignition on.";
CM_ SG_ 261 Passenger_Belt "B1 bits 4:3.";
CM_ SG_ 261 Passenger_Occupied "B2 bits 7:6. Seat weight sensor; clears ~20 s after the seat empties.";
VAL_ 257 Gear_Selector 0 "P" 1 "R" 2 "N" 3 "D" ;
VAL_ 261 Driver_Belt 1 "Buckled" 2 "Unbuckled" 3 "Init" ;
VAL_ 261 Passenger_Belt 1 "Buckled" 2 "Unbuckled" 3 "Init" ;
VAL_ 261 Passenger_Occupied 1 "Occupied" 2 "Empty" 3 "Init" ;
VAL_ 327 Lamp_Mode 0 "Off" 1 "LowBeam" 2 "Parking" 3 "DRL_RightOff" 4 "DRL_LeftOff" 5 "DRL" ;
CM_ SG_ 260 Engine_Oil_Life "Oil life remaining %, B5 bits 6:0 (PCM EngOilLife_Pc_Actl).";
